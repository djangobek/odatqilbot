{
  "name": "discipline-os",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-with-env.mjs scripts/migrate.mjs",
    "db:backup": "node scripts/run-with-env.mjs scripts/backup.mjs",
    "db:import-sqlite": "node scripts/run-with-env.mjs scripts/sqlite-to-postgres.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bot": "node scripts/run-with-env.mjs ./node_modules/tsx/dist/cli.mjs src/bot/index.ts",
    "start:local": "node scripts/run-with-env.mjs scripts/start.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.3",
    "grammy": "^1.35.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.3",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
