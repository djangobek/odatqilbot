# ───────── REQUIRED (production) ─────────
# Token from @BotFather. Keep it secret.
BOT_TOKEN=

# Random secret for session tokens (min 32 chars): openssl rand -hex 32
SESSION_SECRET=

# ───────── LINKS (all web app links come from here) ─────────
# Public HTTPS address of the Mini App. On Railway you may leave this empty:
# RAILWAY_PUBLIC_DOMAIN (set automatically after "Generate Domain") is used as a fallback.
WEB_APP_URL=

# Bot username without @ (shown as a link when the app is opened outside Telegram).
BOT_USERNAME=

# Optional links shown in the bot's /help
SUPPORT_URL=
CHANNEL_URL=

# ───────── DATABASE (PostgreSQL) ─────────
# Local: `docker compose up -d db` gives you exactly this database.
# Railway: add a PostgreSQL service, then set DATABASE_URL to ${{Postgres.DATABASE_URL}} (reference variable).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discipline
# TLS: leave empty for Railway's private network / local; "true" for providers that require SSL;
# "no-verify" for SSL with a self-signed certificate.
# DATABASE_SSL=
# Max connections per process (web and bot each have their own pool)
# DATABASE_POOL_MAX=10
# Target folder for `npm run db:backup` (pg_dump)
# BACKUP_DIR=./backups

# ───────── OPTIONAL ─────────
# Max age of Telegram initData in seconds
TELEGRAM_AUTH_MAX_AGE=86400

# Local development only. NEVER enable in production.
# ALLOW_DEV_LOGIN=true
